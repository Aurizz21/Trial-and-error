@using System.Security.Claims
@using System.Text.Json
@model DashboardSnapshot
@{
    ViewData["Title"] = "Dashboard";
    var username = User.FindFirstValue(ClaimTypes.Name) ?? User.Identity?.Name ?? "user";
    var isOwner = User.IsInRole("Owner");
    var role = isOwner ? "Owner" : "Employee";
    // The page renders itself from this JSON, and refreshes it from /Dashboard/Snapshot.
    var json = JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PoultryOS | Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body data-role="@role"
      data-user="@username"
      data-snapshot-url="@Url.Action("Snapshot", "Dashboard")"
      data-sale-url="@Url.Action("Sale", "Dashboard")"
      data-restock-url="@Url.Action("Restock", "Dashboard")">
    <a class="skip-link" href="#main">Skip to dashboard</a>
    <div id="csrf" hidden>@Html.AntiForgeryToken()</div>
    <script type="application/json" id="dash-data">@Html.Raw(json)</script>

    <div class="shell">
        <aside class="nav" id="nav" aria-label="Main navigation">
            <a class="nav__brand" href="@Url.Action("Index", "Dashboard")"><span class="nav__mark">P</span><span>PoultryOS</span></a>
            <nav>
                <p class="nav__group">Daily work</p>
                <a class="nav__link is-active" href="@Url.Action("Index", "Dashboard")" aria-current="page">Dashboard</a>
                <span class="nav__link is-soon" aria-disabled="true" title="Not built yet">Sales entry<small>Soon</small></span>
                <span class="nav__link is-soon" aria-disabled="true" title="Not built yet">Stock &amp; alerts<small>Soon</small></span>
                <span class="nav__link is-soon" aria-disabled="true" title="Not built yet">Forecast<small>Soon</small></span>
                @if (isOwner)
                {
                    <p class="nav__group">Management</p>
                    <span class="nav__link is-soon" aria-disabled="true" title="Not built yet">Products<small>Soon</small></span>
                    <span class="nav__link is-soon" aria-disabled="true" title="Not built yet">Sales history<small>Soon</small></span>
                    <span class="nav__link is-soon" aria-disabled="true" title="Not built yet">Audit trail<small>Soon</small></span>
                }
            </nav>
            <form class="nav__signout" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit">Sign out</button>
            </form>
        </aside>

        <div class="content">
            <header class="topbar">
                <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-controls="nav" aria-expanded="false">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
                <div class="topbar__farm">
                    <strong>Sunrise Poultry Farm</strong>
                    <span id="today-line"></span>
                </div>
                <label class="search">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    <span class="sr-only">Search products</span>
                    <input id="search" type="search" placeholder="Search products" autocomplete="off" />
                    <kbd aria-hidden="true">/</kbd>
                </label>
                <span class="sync" id="sync" role="status"><span class="sync__dot"></span><span id="sync-text">Live</span></span>
                <div class="user">
                    <span class="user__avatar" aria-hidden="true">@username.Substring(0, 1).ToUpperInvariant()</span>
                    <span class="user__meta"><strong>@username</strong><span>@role</span></span>
                </div>
            </header>

            <div class="workspace">
                <main class="stack" id="main">
                    <div class="greeting">
                        <h1 id="greeting">Good day</h1>
                        <p>@(isOwner ? "You can record sales, log restocks and see the full activity log." : "You can record sales and check stock levels.")</p>
                    </div>

                    <section class="panel kpis" aria-label="Today at a glance">
                        <div class="kpi">
                            <span class="kpi__label">Units in stock</span>
                            <strong class="kpi__value" id="kpi-stock">0</strong>
                            <span class="kpi__sub" id="kpi-stock-sub"></span>
                        </div>
                        <div class="kpi">
                            <span class="kpi__label">Sold today</span>
                            <strong class="kpi__value" id="kpi-sold">0</strong>
                            <span class="kpi__sub" id="kpi-sold-sub"></span>
                        </div>
                        <div class="kpi">
                            <span class="kpi__label">Active alerts</span>
                            <strong class="kpi__value" id="kpi-alerts">0</strong>
                            <span class="kpi__sub" id="kpi-alerts-sub"></span>
                        </div>
                        <div class="kpi">
                            <span class="kpi__label">Forecast accuracy</span>
                            <strong class="kpi__value" id="kpi-acc">&ndash;</strong>
                            <span class="kpi__sub" id="kpi-acc-sub"></span>
                        </div>
                    </section>

                    <section class="panel" aria-labelledby="attn-title">
                        <div class="panel__head">
                            <h2 id="attn-title">Needs reordering</h2>
                            <span class="panel__note" id="attention-count"></span>
                        </div>
                        <ul class="attn-list" id="attention-list"></ul>
                    </section>

                    <div class="grid-2 grid-2--wide-left">
                        <section class="panel" aria-labelledby="trend-title">
                            <div class="panel__head">
                                <h2 id="trend-title">Daily sales, last 14 days</h2>
                                <label class="select">
                                    <span class="sr-only">Show sales for</span>
                                    <select id="trend-select"></select>
                                </label>
                            </div>
                            <div class="legend">
                                <span><i class="sw sw--actual"></i>Units sold</span>
                                <span><i class="sw sw--wma"></i>7-day weighted average</span>
                                <span><i class="sw sw--today"></i>Today, still counting</span>
                            </div>
                            <div class="chart" id="trend-chart"></div>
                        </section>

                        <section class="panel" aria-labelledby="health-title">
                            <div class="panel__head"><h2 id="health-title">Stock health</h2></div>
                            <div class="health">
                                <div class="donut" id="health-donut"></div>
                                <div class="health__legend" id="health-legend"></div>
                            </div>
                        </section>
                    </div>

                    <div class="grid-2">
                        <section class="panel" aria-labelledby="cat-title">
                            <div class="panel__head">
                                <h2 id="cat-title">Used last week, by category</h2>
                            </div>
                            <div class="bars" id="category-bars"></div>
                        </section>

                        <section class="panel" aria-labelledby="dep-title">
                            <div class="panel__head">
                                <h2 id="dep-title">When stock runs out</h2>
                                <label class="select">
                                    <span class="sr-only">Forecast product</span>
                                    <select id="depletion-select"></select>
                                </label>
                            </div>
                            <dl class="dep-stats" id="depletion-stats"></dl>
                            <div class="chart" id="depletion-chart"></div>
                        </section>
                    </div>

                    <section class="panel panel--flush" aria-labelledby="stock-title">
                        <div class="panel__head panel__head--pad">
                            <h2 id="stock-title">Stock position</h2>
                            <span class="panel__note" id="stock-count"></span>
                        </div>
                        <div class="filters" id="filters" role="group" aria-label="Filter by status"></div>
                        <div class="table-wrap">
                            <table class="stock-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Product</th>
                                        <th scope="col" class="num">In stock</th>
                                        <th scope="col" class="num hide-sm">Reorder level</th>
                                        <th scope="col" class="num hide-sm">Used last week</th>
                                        <th scope="col" class="hide-sm">14-day sales</th>
                                        <th scope="col" class="num">Days left</th>
                                        <th scope="col" class="hide-md">Runs out</th>
                                        <th scope="col">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="stock-body"></tbody>
                            </table>
                        </div>
                    </section>
                </main>

                <aside class="rail" id="rail" aria-label="Record stock">
                    <form class="panel entry" id="entry-form" novalidate>
                        <div class="panel__head">
                            <h2 id="entry-title">Record a sale</h2>
                            <button class="icon-btn sheet-close" id="sheet-close" type="button" aria-label="Close">
                                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                            </button>
                        </div>

                        @if (isOwner)
                        {
                            <div class="tabs" role="group" aria-label="Type of entry">
                                <button type="button" class="tab is-active" id="tab-sale" aria-pressed="true">Sale</button>
                                <button type="button" class="tab" id="tab-restock" aria-pressed="false">Restock</button>
                            </div>
                        }

                        <fieldset class="entry__products">
                            <legend>Product</legend>
                            <div class="chips" id="chips"></div>
                        </fieldset>

                        <div class="entry__qty">
                            <label for="qty">Quantity</label>
                            <div class="stepper">
                                <button type="button" class="btn-step" id="qty-dec" aria-label="One less">&minus;</button>
                                <input id="qty" type="number" inputmode="numeric" min="1" step="1" value="1" />
                                <button type="button" class="btn-step" id="qty-inc" aria-label="One more">+</button>
                            </div>
                        </div>

                        <p class="entry__preview" id="preview" aria-live="polite"></p>
                        <button class="btn" id="submit" type="submit">Record sale</button>
                        <p class="entry__msg" id="entry-msg" role="status"></p>
                    </form>

                    @if (isOwner)
                    {
                        <section class="panel activity" aria-labelledby="act-title">
                            <div class="panel__head"><h2 id="act-title">Recent activity</h2></div>
                            <ol class="activity__list" id="activity"></ol>
                        </section>
                    }
                </aside>
            </div>
        </div>
    </div>

    <button class="fab" id="fab" type="button">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        Record sale
    </button>
    <div class="scrim" id="scrim"></div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
