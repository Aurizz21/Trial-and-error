@model PoultryOS.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PoultryOS | Sign in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <section class="brand-panel" aria-label="PoultryOS overview">
            <div class="brand-content">
                <a class="brand" href="@Url.Action("Login", "Account")"><span class="brand-mark">P</span><span>PoultryOS</span></a>
                <p class="product-label">Inventory &amp; Forecast Platform</p>
                <h1>Know what you have.<br /><em>Plan what comes next.</em></h1>
                <p class="tagline">Smart inventory management for growing poultry businesses.</p>
                <div class="stat-grid" aria-label="Platform metrics">
                    <div class="stat-card"><span class="stat-icon stock-icon">&#9632;</span><strong>Stock Level</strong><span class="stat-value">94.8%</span><span class="stat-trend">&#8593; 4.2% this week</span></div>
                    <div class="stat-card"><span class="stat-icon alert-icon">!</span><strong>Alerts</strong><span class="stat-value">03</span><span class="stat-trend">Needs attention</span></div>
                    <div class="stat-card"><span class="stat-icon accuracy-icon">&#10003;</span><strong>Accuracy</strong><span class="stat-value">98.2%</span><span class="stat-trend">Forecast precision</span></div>
                </div>
            </div>
            <div class="panel-detail" aria-hidden="true"><span></span><span></span><span></span></div>
        </section>

        <section class="form-panel">
            <div class="login-card">
                <div class="form-heading">
                    <span class="mobile-brand">PoultryOS</span>
                    <p class="eyebrow">Secure workspace access</p>
                    <h2>Welcome back</h2>
                    <p>Sign in to your inventory dashboard</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post" id="login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="field-group">
                        <label asp-for="Username"></label>
                        <input asp-for="Username" autocomplete="username" placeholder="Enter your username" autofocus />
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Password"></label>
                        <div class="password-wrap">
                            <input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" />
                            <button type="button" class="password-toggle" id="password-toggle" aria-label="Show password">Show</button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <div class="form-options">
                        <label class="remember-label"><input asp-for="RememberMe" /><span>Remember me</span></label>
                        <span class="secure-label"><span>&#10003;</span> Secure sign in</span>
                    </div>
                    <button class="submit-button" type="submit" id="submit-button"><span class="button-label">Sign in</span><span class="button-arrow" aria-hidden="true">&#8594;</span></button>
                </form>
                <p class="access-note">Use your PoultryOS account credentials to continue.</p>
            </div>
            <p class="copyright">PoultryOS &copy; 2026 &nbsp;&bull;&nbsp; Built for better decisions</p>
        </section>
    </main>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
