@model PoultryOS.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Poultry OS | Sign in</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-page">
        <video class="login-video"
               src="@Url.Content("~/videos/login-video.mp4")"
               poster="@Url.Content("~/images/login-poster.jpg")"
               muted loop playsinline autoplay preload="metadata" aria-hidden="true" tabindex="-1"></video>
        <div class="login-overlay" aria-hidden="true"></div>
        <a class="login-logo" href="@Url.Action("Login", "Account")" aria-label="Poultry OS sign in">
            <img src="~/images/logo.svg" alt="" asp-append-version="true" />
        </a>
        <div class="login-content">
            <div class="login-card">
                <div class="form-heading">
                    <p class="eyebrow">Owner and employee sign-in</p>
                    <h1 id="login-heading">Welcome back</h1>
                    <p>Check stock, record sales, and see what's ahead.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post" id="login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="field-group">
                        <label asp-for="Username"></label>
                        <input asp-for="Username" autocomplete="username" placeholder="Enter your username" autofocus />
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Password"></label>
                        <div class="password-wrap">
                            <input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" />
                            <button type="button" class="password-toggle" id="password-toggle" aria-label="Show password">Show</button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <div class="form-options">
                        <label class="remember-label"><input asp-for="RememberMe" /><span>Remember me</span></label>
                        <span class="secure-label"><span>&#10003;</span> Secure sign in</span>
                    </div>
                    <button class="submit-button" type="submit" id="submit-button"><span class="button-label">Sign in</span><span class="button-arrow" aria-hidden="true">&#8594;</span></button>
                </form>
            </div>
        </div>
        <p class="login-copyright">Poultry OS &copy; 2026</p>
    </main>

    <script src="~/js/login.js" asp-append-version="true"></script>
    <script>
        (() => {
            const video = document.querySelector(".login-video");
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
            const smallViewport = window.matchMedia("(max-width: 700px)");
            const syncPlayback = () => {
                if (reducedMotion.matches || smallViewport.matches) {
                    video.pause();
                    return;
                }
                const playback = video.play();
                if (playback && typeof playback.catch === "function") playback.catch(() => {});
            };
            syncPlayback();
            reducedMotion.addEventListener?.("change", syncPlayback);
            smallViewport.addEventListener?.("change", syncPlayback);
        })();
    </script>
</body>
</html>
