@{ Layout = "~/Views/Shared/_DashboardLayout.cshtml"; ViewData["Title"] = "Product Management"; }
<div class="module-page" data-owner-only><span class="preview-badge">UI Preview - no backend yet</span><header class="module-heading"><div><p class="greeting">Owner workspace</p><h1>Product Management</h1><p>Manage the five active products and their reorder rules.</p></div><button id="openProductModal" class="primary-btn" type="button">+ Add Product</button></header>
<section class="stat-strip"><article class="kpi-card"><div class="kpi-label">Total Products</div><div class="kpi-value">5</div></article><article class="kpi-card"><div class="kpi-label">Active Alerts</div><div class="kpi-value">2</div></article><article class="kpi-card"><div class="kpi-label">Weekly Sales</div><div class="kpi-value">237</div><div class="kpi-meta">Across all products</div></article><article class="kpi-card"><div class="kpi-label">System Status</div><div class="kpi-value" style="color: var(--healthy)">Online</div></article></section>
<section class="panel"><div class="tabs"><button class="tab-btn active" data-tab="productsTab" type="button">Products</button><button class="tab-btn" data-tab="thresholdsTab" type="button">Thresholds</button><button class="tab-btn" data-tab="settingsTab" type="button">System Settings</button><a class="tab-btn" href="/Audit/Index">Audit Logs</a></div>
<div id="productsTab" class="tab-panel active"><div class="toolbar"><input id="productSearch" type="search" placeholder="Search products..."><select id="productCategory"><option>All</option><option>Whole Chicken</option><option>Cuts &amp; Parts</option></select></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Category</th><th>Current Stock</th><th>Threshold</th><th>Weekly Consumption</th><th>Status</th><th>Actions</th></tr></thead><tbody id="productsBody"><tr data-name="Whole Chicken" data-category="Whole Chicken"><td>Whole Chicken</td><td>Whole Chicken</td><td>126 pcs</td><td>60 pcs</td><td>84 pcs</td><td><span class="status-badge status-healthy">Healthy</span></td><td class="table-action"><button class="small-btn" type="button">Edit</button><button class="danger-btn small-btn" type="button">Delete</button></td></tr><tr data-name="Chicken Breast" data-category="Cuts &amp; Parts"><td>Chicken Breast</td><td>Cuts &amp; Parts</td><td>18 kg</td><td>35 kg</td><td>105 kg</td><td><span class="status-badge status-critical">Critical</span></td><td class="table-action"><button class="small-btn" type="button">Edit</button><button class="danger-btn small-btn" type="button">Delete</button></td></tr><tr data-name="Chicken Thigh" data-category="Cuts &amp; Parts"><td>Chicken Thigh</td><td>Cuts &amp; Parts</td><td>72 kg</td><td>40 kg</td><td>49 kg</td><td><span class="status-badge status-healthy">Healthy</span></td><td class="table-action"><button class="small-btn" type="button">Edit</button><button class="danger-btn small-btn" type="button">Delete</button></td></tr><tr data-name="Chicken Wings" data-category="Cuts &amp; Parts"><td>Chicken Wings</td><td>Cuts &amp; Parts</td><td>42 kg</td><td>50 kg</td><td>61 kg</td><td><span class="status-badge status-warning">Warning</span></td><td class="table-action"><button class="small-btn" type="button">Edit</button><button class="danger-btn small-btn" type="button">Delete</button></td></tr><tr data-name="Chicken Feet" data-category="Cuts &amp; Parts"><td>Chicken Feet</td><td>Cuts &amp; Parts</td><td>66 kg</td><td>30 kg</td><td>35 kg</td><td><span class="status-badge status-healthy">Healthy</span></td><td class="table-action"><button class="small-btn" type="button">Edit</button><button class="danger-btn small-btn" type="button">Delete</button></td></tr></tbody></table></div></div>
<div id="thresholdsTab" class="tab-panel"><p class="panel-note">Preview thresholds are editable locally and are not saved.</p><div class="form-grid" style="margin-top: 16px"><label class="field">Whole Chicken<div class="input-with-unit"><input type="number" value="60"><span class="unit-label">pcs</span></div></label><label class="field">Chicken Breast<div class="input-with-unit"><input type="number" value="35"><span class="unit-label">kg</span></div></label><label class="field">Chicken Thigh<div class="input-with-unit"><input type="number" value="40"><span class="unit-label">kg</span></div></label><label class="field">Chicken Wings<div class="input-with-unit"><input type="number" value="50"><span class="unit-label">kg</span></div></label><label class="field">Chicken Feet<div class="input-with-unit"><input type="number" value="30"><span class="unit-label">kg</span></div></label></div><button id="saveThresholds" class="primary-btn" type="button" style="margin-top: 18px">Save Thresholds</button></div>
<div id="settingsTab" class="tab-panel"><div class="toggle-row"><div><strong>Enable email alerts</strong><p class="panel-note">Preview only - no messages are sent.</p></div><label class="toggle"><input type="checkbox" checked><span></span></label></div><div class="toggle-row"><div><strong>Enable low-stock SMS</strong><p class="panel-note">Preview only - no messages are sent.</p></div><label class="toggle"><input type="checkbox"><span></span></label></div></div></section></div>
<div id="productModalOverlay" class="modal-backdrop" aria-hidden="true"><div id="productModalBox" class="modal" role="dialog" aria-modal="true" aria-labelledby="productModalTitle"><div class="modal-header"><h2 id="productModalTitle">Add Product</h2><button id="closeProductModal" class="modal-close modal-close-btn" type="button" aria-label="Close">&times;</button></div><form id="productForm" class="form-grid"><label class="field full">Name<input id="productName" required placeholder="Product name"></label><label class="field">Category<select id="productCategoryInput"><option>Whole Chicken</option><option>Cuts &amp; Parts</option></select></label><label class="field">Unit<select id="productUnit"><option>pcs</option><option>kg</option></select></label><label class="field">Starting Stock<input id="startingStock" type="number" min="0" placeholder="0"></label><label class="field">Reorder Threshold<input id="reorderThreshold" type="number" min="0" placeholder="0"></label><label class="field full">Supplier<input id="supplier" placeholder="Supplier name"></label><div class="button-row field full"><button id="exitProduct" class="secondary-btn modal-close-btn" type="button">Exit</button><button id="cancelProduct" class="secondary-btn modal-close-btn" type="button">Cancel</button><button class="primary-btn" type="submit">Save</button></div></form></div></div><div id="productToast" class="toast">Preview saved - nothing was sent</div>
<script src="~/js/products.js" asp-append-version="true"></script>