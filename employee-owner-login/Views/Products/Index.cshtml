@using System.Globalization
@using PoultryOS.Models
@model ProductsPageViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Product Management";

    // Show = what people read. Inv = the culture-safe format used inside data-* / value attributes.
    string Show(decimal value) => value.ToString("0.##");
    string Inv(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
<div class="module-page" data-owner-only>
    @Html.AntiForgeryToken()

    <header class="module-heading">
        <div>
            <p class="greeting">Owner workspace</p>
            <h1>Product Management</h1>
            <p>Manage your products and their reorder rules.</p>
        </div>
        <button id="openProductModal" class="primary-btn" type="button">+ Add Product</button>
    </header>

    <section class="stat-strip">
        <article class="kpi-card"><div class="kpi-label">Total Products</div><div class="kpi-value">@Model.TotalProducts</div></article>
        <article class="kpi-card"><div class="kpi-label">Active Alerts</div><div class="kpi-value">@Model.ActiveAlerts</div></article>
        <article class="kpi-card"><div class="kpi-label">Weekly Sales</div><div class="kpi-value">@Show(Model.WeeklySales)</div><div class="kpi-meta">Across all products</div></article>
        <article class="kpi-card"><div class="kpi-label">System Status</div><div class="kpi-value accuracy-value">Online</div></article>
    </section>

    <section class="panel">
        <div class="tabs">
            <button class="tab-btn active" data-tab="productsTab" type="button">Products</button>
            <button class="tab-btn" data-tab="thresholdsTab" type="button">Thresholds</button>
            <button class="tab-btn" data-tab="settingsTab" type="button">System Settings</button>
            <a class="tab-btn" href="/Audit/Index">Audit Logs</a>
        </div>

        <div id="productsTab" class="tab-panel active">
            <div class="toolbar">
                <input id="productSearch" type="search" placeholder="Search products...">
                <select id="productCategory">
                    <option>All</option>
                    <option>Whole Chicken</option>
                    <option>Cuts &amp; Parts</option>
                </select>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Name</th><th>Category</th><th>Current Stock</th><th>Threshold</th><th>Weekly Consumption</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="productsBody">
                        @foreach (var r in Model.Products)
                        {
                            <tr data-name="@r.Name" data-category="@r.Category">
                                <td>@r.Name</td>
                                <td>@r.Category</td>
                                <td>@Show(r.CurrentStock) @r.Units</td>
                                <td>@Show(r.ReorderThreshold) @r.Units</td>
                                <td>@Show(r.WeeklyConsumption) @r.Units</td>
                                <td><span class="status-badge status-@r.Status.ToLowerInvariant()">@r.Status</span></td>
                                <td class="table-action">
                                    <button class="small-btn edit-product-btn" type="button"
                                            data-id="@r.Id" data-name="@r.Name" data-category="@r.Category"
                                            data-units="@r.Units" data-supplier="@r.Supplier"
                                            data-stock="@Inv(r.CurrentStock)" data-threshold="@Inv(r.ReorderThreshold)">Edit</button>
                                    <button class="small-btn restock-product-btn" type="button"
                                            data-id="@r.Id" data-name="@r.Name"
                                            data-stock="@Inv(r.CurrentStock)" data-units="@r.Units">Restock</button>
                                    <button class="danger-btn small-btn delete-product-btn" type="button"
                                            data-id="@r.Id" data-name="@r.Name">Delete</button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Products.Any())
                        {
                            <tr><td colspan="7" class="empty-state"><strong>No products yet</strong><span>Click "+ Add Product" to create one.</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="thresholdsTab" class="tab-panel">
            <p class="panel-note">Set the stock level at which each product is flagged for reordering.</p>
            <div class="form-grid">
                @foreach (var r in Model.Products)
                {
                    <label class="field">@r.Name
                        <div class="input-with-unit">
                            <input type="number" min="0" step="0.01" value="@Inv(r.ReorderThreshold)" data-threshold-id="@r.Id">
                            <span class="unit-label">@r.Units</span>
                        </div>
                    </label>
                }
                <div class="button-row field full"><button id="saveThresholds" class="primary-btn" type="button">Save Thresholds</button></div>
            </div>
        </div>

        <div id="settingsTab" class="tab-panel">
            <div class="toggle-row"><div><strong>Enable email alerts</strong><p class="panel-note">Preview only - no messages are sent.</p></div><label class="toggle"><input type="checkbox" checked><span></span></label></div>
            <div class="toggle-row"><div><strong>Enable low-stock SMS</strong><p class="panel-note">Preview only - no messages are sent.</p></div><label class="toggle"><input type="checkbox"><span></span></label></div>
        </div>
    </section>
</div>

<div id="productModalOverlay" class="modal-backdrop" aria-hidden="true">
    <div id="productModalBox" class="modal" role="dialog" aria-modal="true" aria-labelledby="productModalTitle">
        <div class="modal-header">
            <h2 id="productModalTitle">Add Product</h2>
            <button id="closeProductModal" class="modal-close modal-close-btn" type="button" aria-label="Close">&times;</button>
        </div>
        <form id="productForm" class="form-grid">
            <input type="hidden" id="productId">
            <label class="field full">Name<input id="productName" required maxlength="100" placeholder="Product name"></label>
            <label class="field">Category
                <select id="productCategoryInput"><option>Whole Chicken</option><option>Cuts &amp; Parts</option></select>
            </label>
            <label class="field">Unit
                <select id="productUnit"><option>pcs</option><option>kg</option></select>
            </label>
            <label class="field"><span id="stockLabel">Starting Stock</span><input id="startingStock" type="number" min="0" step="0.01" placeholder="0"></label>
            <label class="field">Reorder Threshold<input id="reorderThreshold" type="number" min="0" step="0.01" placeholder="0"></label>
            <label class="field full">Supplier<input id="supplier" maxlength="100" placeholder="Supplier name"></label>
            <div class="button-row field full">
                <button id="cancelProduct" class="secondary-btn modal-close-btn" type="button">Cancel</button>
                <button class="primary-btn" type="submit">Save</button>
            </div>
        </form>
    </div>
</div>

<div id="restockModalOverlay" class="modal-backdrop" aria-hidden="true">
    <div id="restockModalBox" class="modal" role="dialog" aria-modal="true" aria-labelledby="restockModalTitle">
        <div class="modal-header">
            <h2 id="restockModalTitle">Restock Product</h2>
            <button id="closeRestockModal" class="modal-close modal-close-btn" type="button" aria-label="Close">&times;</button>
        </div>
        <form id="restockForm" class="form-grid">
            <input type="hidden" id="restockProductId">
            <div class="field full">
                <strong id="restockProductName" style="font-size: 1rem;"></strong>
                <p class="panel-note" style="margin-top: 4px;">
                    Current stock: <span id="restockCurrentStock">0</span> <span id="restockUnits"></span>
                </p>
            </div>
            <label class="field full">Quantity to Add
                <input id="restockQuantity" type="number" min="0.01" step="0.01" placeholder="e.g. 50" required>
            </label>
            <label class="field full">Notes (optional)
                <input id="restockNotes" maxlength="500" placeholder="Supplier, invoice #, etc.">
            </label>
            <div class="button-row field full">
                <button id="cancelRestock" class="secondary-btn modal-close-btn" type="button">Cancel</button>
                <button class="primary-btn" type="submit">Restock</button>
            </div>
        </form>
    </div>
</div>

<div id="productToast" class="toast"></div>
<script src="~/js/products.js" asp-append-version="true"></script>