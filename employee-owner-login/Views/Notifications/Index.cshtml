@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Notifications";
}

<section class="module-page notifications-page" aria-labelledby="notificationsTitle">
    <header class="module-heading">
        <div>
            <p class="greeting">Manok ni Rene</p>
            <h1 id="notificationsTitle">Notifications</h1>
            <p>Inventory, sales, and forecast updates.</p>
        </div>
    </header>
    <nav class="notification-filters" aria-label="Filter notifications">
        <button class="notification-filter active" type="button" data-notification-filter="all" aria-pressed="true">All</button>
        <button class="notification-filter" type="button" data-notification-filter="unread" aria-pressed="false">Unread</button>
        <button class="notification-filter" type="button" data-notification-filter="critical" aria-pressed="false">Critical</button>
        <button class="notification-filter" type="button" data-notification-filter="warning" aria-pressed="false">Warning</button>
        <button class="notification-filter" type="button" data-notification-filter="info" aria-pressed="false">Info</button>
    </nav>
    <div id="notificationsPageList" class="notifications-page-list"></div>
    <div id="notificationsPageEmpty" class="notification-page-empty empty-state" hidden>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <strong>No notifications match this filter.</strong>
        <span>Try another filter to see other shop updates.</span>
    </div>
</section>

<script>document.body.dataset.notificationsPage = 'true';</script>
