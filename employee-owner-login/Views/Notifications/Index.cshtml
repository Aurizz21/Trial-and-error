@using PoultryOS.Models
@model NotificationsPageViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Notifications";
}
<div class="module-page">
    <header class="module-heading">
        <div>
            <p class="greeting">System workspace</p>
            <h1>Notifications</h1>
            <p>Alerts, warnings, and updates from across the system.</p>
        </div>
    </header>

    <section class="stat-strip">
        <article class="kpi-card">
            <div class="kpi-label">Total</div>
            <div class="kpi-value">@Model.TotalCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Unread</div>
            <div class="kpi-value">@Model.UnreadCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Critical</div>
            <div class="kpi-value status-critical">@Model.CriticalCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Warning</div>
            <div class="kpi-value status-warning">@Model.WarningCount</div>
        </article>
    </section>

    <section class="panel">
        <div class="toolbar">
            <label class="field">Filter
                <select onchange="location.href='/Notifications?type=' + this.value">
                    <option value="All" selected="@(Model.TypeFilter == "All")">All</option>
                    <option value="Unread" selected="@(Model.TypeFilter == "Unread")">Unread</option>
                    <option value="Critical" selected="@(Model.TypeFilter == "Critical")">Critical</option>
                    <option value="Warning" selected="@(Model.TypeFilter == "Warning")">Warning</option>
                    <option value="Info" selected="@(Model.TypeFilter == "Info")">Info</option>
                </select>
            </label>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Title</th>
                        <th>Message</th>
                        <th>Created</th>
                        <th>Read</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.Notifications)
                    {
                        <tr class="@(n.IsRead ? "" : "unread-row")">
                            <td><span class="status-badge status-@n.Type.ToLowerInvariant()">@n.Type</span></td>
                            <td>@n.Title</td>
                            <td>@n.Message</td>
                            <td>@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(n.IsRead ? "✓" : "—")</td>
                        </tr>
                    }
                    @if (!Model.Notifications.Any())
                    {
                        <tr>
                            <td colspan="5" class="empty-state">
                                <strong>No notifications</strong>
                                <span>You're all caught up.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>