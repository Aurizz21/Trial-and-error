@using System.Security.Claims
@{
    var userName = Context.User.Identity?.Name ?? "User";
    var role = Context.User.IsInRole("Owner") ? "Owner" : "Employee";
    var criticalAlertCount = ViewData["CriticalAlertCount"] ?? 0;
    var alertBadge = criticalAlertCount is int c ? c : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manok ni Rene</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
</head>
<body class="dashboard-body">
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <img class="logo-mark" src="/images/logo.svg" alt="" />
                <div>
                    <div class="logo-text">Manok ni Rene</div>
                    <small>Stock &amp; sales</small>
                </div>
            </div>

            <nav class="sidebar-nav" aria-label="Sidebar navigation">
                <div class="nav-group-label">Shop</div>
                <a class="nav-link" href="/Dashboard/Index">Dashboard</a>
                <a class="nav-link" href="/Sales/Entry">Sales Entry</a>
                <a class="nav-link" href="/Stock/Alerts">
                    <span>Stock &amp; Alerts</span>
                    <span class="nav-badge badge-critical">@alertBadge</span>
                </a>
                <a class="nav-link" href="/Forecast/Index">Forecast</a>

                <div class="nav-group-label">Manage</div>
                <a class="nav-link owner-only" href="/Products/Index">Product Management</a>
                <a class="nav-link" href="/Sales/History">Sales History</a>
                <a class="nav-link owner-only" href="/Audit/Index">Audit Trail</a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="avatar">@userName.Substring(0, 1).ToUpperInvariant()</div>
                    <div>
                        <strong>@userName</strong>
                        <small>@role</small>
                    </div>
                </div>
                <form class="signout-form" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="signout-link">Sign out</button>
                </form>
            </div>
        </aside>
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="mobile-menu" type="button" aria-label="Open navigation">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </button>
                    <div class="farm-title">Manok ni Rene</div>
                </div>

                <div class="topbar-search">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
                        <circle cx="10.8" cy="10.8" r="6.3" />
                        <path d="m15.5 15.5 4.2 4.2" />
                    </svg>
                    <input type="search" placeholder="Search products, alerts, or sales" aria-label="Search" />
                </div>

                <div class="topbar-right">
                    <div class="date-pill">@DateTime.Now.ToString("ddd, MMM dd")</div>
                    <div class="notification-area">
                    <button id="notificationToggle" class="notification-btn" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="notificationPanel">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                        </svg>
                        <span id="notificationBadge" class="notification-badge" aria-live="polite" hidden></span>
                    </button>
                    <section id="notificationPanel" class="notification-panel" aria-label="Notifications" hidden>
                        <div class="notification-panel-header">
                            <h2>Notifications</h2>
                            <button id="markAllNotificationsRead" class="notification-text-button" type="button">Mark all as read</button>
                        </div>
                        <div id="notificationDropdownList" class="notification-list"></div>
                        <a class="notification-panel-footer" href="/Notifications/Index">View all notifications</a>
                    </section>
                    </div>
                </div>
            </header>

            <div id="offlineBanner" class="offline-banner hidden" aria-live="polite"></div>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/chartjs/chart.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
</body>
</html>
