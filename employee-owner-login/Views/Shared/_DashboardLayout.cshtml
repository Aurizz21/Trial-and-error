@using System.Security.Claims
@{
    var userName = Context.User.Identity?.Name ?? "User";
    var role = Context.User.IsInRole("Owner") ? "Owner" : "Employee";
    var criticalAlertCount = ViewData["CriticalAlertCount"] ?? 0;
    var alertBadge = criticalAlertCount is int c ? c : 0;
    var bodyClass = ViewData["BodyClass"] as string;
    var pageTitle = ViewData["Title"] as string ?? "Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manok ni Rene</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
</head>
<body class="dashboard-body @bodyClass">
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <span class="logo-chip"><img class="logo-mark" src="/images/logo.svg" alt="" /></span>
                <div>
                    <div class="logo-text">Manok ni Rene</div>
                    <small>Stock &amp; sales</small>
                </div>
            </div>

            <nav class="sidebar-nav" aria-label="Sidebar navigation">
                <div class="nav-group-label">
                    <svg class="nav-group-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                    <span>Shop</span>
                </div>
                <a class="nav-link" href="/Dashboard/Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="7" height="7" rx="2" /><rect x="13.5" y="3.5" width="7" height="7" rx="2" /><rect x="3.5" y="13.5" width="7" height="7" rx="2" /><rect x="13.5" y="13.5" width="7" height="7" rx="2" /></svg>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link" href="/Sales/Entry">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5h17" /><path d="M6 16.4l4.6-5 3.4 3 5.4-6.9" /><path d="M15.3 7.5h4.3v4.3" /></svg>
                    <span>Sales Entry</span>
                </a>
                <a class="nav-link" href="/Stock/Alerts">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.6 20 7v5.2L12 15.6 4 12.2V7z" /><path d="M4 12.2V17l8 3.4 8-3.4v-4.8" /><path d="M12 8.4v4" /></svg>
                    <span>Stocks &amp; Alerts</span>
                    <span class="nav-badge badge-critical">@alertBadge</span>
                </a>
                <a class="nav-link" href="/Forecast/Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.4" /><path d="m15.4 15.4 4.6 4.6" /><path d="M8.2 13v-2.4M10.5 13V8.6M12.8 13v-1.6" /></svg>
                    <span>Forecast</span>
                </a>

                <div class="nav-group-label"><span>Manage</span></div>
                <a class="nav-link owner-only" href="/Products/Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.5 3.9 18 8v4" /><path d="M10.5 3.9 3 8v8l7.5 4 2.6-1.4" /><path d="M10.5 3.9V12L3 8" /><circle cx="17.5" cy="17.5" r="2.4" /><path d="M17.5 13.9v1.2M17.5 19.9v1.2M21.1 17.5h-1.2M15.1 17.5h-1.2" /></svg>
                    <span>Product Management</span>
                </a>
                <a class="nav-link" href="/Sales/History">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.9 12a8.1 8.1 0 1 0 2.6-6" /><path d="M3.6 4.3v4.2h4.2" /><path d="M12 8.2V12l3 1.8" /></svg>
                    <span>Sales History</span>
                </a>
                <a class="nav-link owner-only" href="/Audit/Index">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3.6h12v16.8H6z" /><path d="M9 8h6M9 11.4h4" /><circle cx="14.4" cy="15.8" r="2.6" /><path d="m16.5 17.9 1.9 1.9" /></svg>
                    <span>Audit Trail</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="avatar" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><circle cx="12" cy="9" r="3.7" /><path d="M12 14.3c-3.6 0-6.4 2.2-6.9 5.1a.6.6 0 0 0 .6.7h12.6a.6.6 0 0 0 .6-.7c-.5-2.9-3.3-5.1-6.9-5.1Z" /></svg>
                    </div>
                    <div>
                        <strong>@userName</strong>
                        <small>@role</small>
                    </div>
                </div>
                <form class="signout-form" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="signout-link">Sign Out</button>
                </form>
            </div>
        </aside>
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="mobile-menu" type="button" aria-label="Open navigation">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </button>
                    @* Pages that opted into the new skin show their own title here;
                       legacy pages keep the brand mark in the top bar. *@
                    <div class="farm-title">@(string.IsNullOrEmpty(bodyClass) ? "Manok ni Rene" : pageTitle)</div>
                </div>

                <div class="topbar-search global-search" id="globalSearch">
                    <button class="global-search-trigger" type="button" aria-label="Open search" aria-controls="globalSearchResults">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
                            <circle cx="10.8" cy="10.8" r="6.3" />
                            <path d="m15.5 15.5 4.2 4.2" />
                        </svg>
                    </button>
                    <input id="globalSearchInput" type="search" placeholder="Search Products, Alerts, or Sales&hellip;" aria-label="Search products, alerts, or sales" autocomplete="off" aria-expanded="false" aria-controls="globalSearchResults" />
                    <div id="globalSearchResults" class="global-search-results" role="region" aria-label="Search results" hidden>
                        <div class="global-search-filters">
                            <span>Limit sales by date</span>
                            <label>From <input id="globalSearchFrom" type="date" /></label>
                            <label>To <input id="globalSearchTo" type="date" /></label>
                        </div>
                        <div class="global-search-suggestions" role="group" aria-label="Try searching for" hidden>
                            <span>Try searching for&hellip;</span>
                            <div class="global-search-chips">
                                @if (role == "Owner")
                                {
                                    <button type="button" data-search-term="Critical">Critical alerts</button>
                                    <button type="button" data-search-term="Chicken Breast">Chicken Breast</button>
                                    <button type="button" data-search-term="Whole Chicken">Whole Chicken</button>
                                    <button type="button" data-search-term="Chicken Wings">Chicken Wings</button>
                                }
                                else
                                {
                                    <button type="button" data-search-term="Critical">Critical alerts</button>
                                    <button type="button" data-search-term="Chicken Breast">Chicken Breast sales</button>
                                    <button type="button" data-search-term="Whole Chicken">Whole Chicken sales</button>
                                    <button type="button" data-search-term="Chicken Wings">Chicken Wings sales</button>
                                }
                            </div>
                        </div>
                        <p class="global-search-status" role="status" aria-live="polite"></p>
                        <div class="global-search-groups"></div>
                    </div>
                </div>

                <div class="topbar-right">
                    <div class="date-pill">@DateTime.Now.ToString("ddd, MMM dd")</div>
                    <div class="notification-area">
                    <button id="notificationToggle" class="notification-btn" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="notificationPanel">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                        </svg>
                        <span id="notificationBadge" class="notification-badge" aria-live="polite" hidden></span>
                    </button>
                    <section id="notificationPanel" class="notification-panel" aria-label="Notifications" hidden>
                        <div class="notification-panel-header">
                            <h2>Notifications</h2>
                            <button id="markAllNotificationsRead" class="notification-text-button" type="button">Mark all as read</button>
                        </div>
                        <div id="notificationDropdownList" class="notification-list"></div>
                        <a class="notification-panel-footer" href="/Notifications/Index">View all notifications</a>
                    </section>
                    </div>
                </div>
            </header>

            <div id="offlineBanner" class="offline-banner hidden" aria-live="polite"></div>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/chartjs/chart.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
</body>
</html>
