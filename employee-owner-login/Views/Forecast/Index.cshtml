@{ Layout = "~/Views/Shared/_DashboardLayout.cshtml"; ViewData["Title"] = "Forecast"; }
<div class="module-page"><span class="preview-badge">UI Preview - no backend yet</span><header class="module-heading"><div><p class="greeting">Planning view</p><h1>Forecast</h1><p>Preview demand direction and projected stock depletion.</p></div><label class="field">Product<select id="forecastProduct"><option>Whole Chicken</option><option>Chicken Breast</option><option>Chicken Thigh</option><option>Chicken Wings</option><option>Chicken Feet</option></select></label></header>
<section class="stat-strip"><article class="kpi-card"><div class="kpi-label">Avg Daily Sales</div><div id="avgSales" class="kpi-value">12 pcs</div><div class="kpi-meta">7-day weighted average</div></article><article class="kpi-card"><div class="kpi-label">Expected Depletion</div><div id="depletionDate" class="kpi-value">Oct 02</div><div class="kpi-meta">At current sales rate</div></article><article class="kpi-card"><div class="kpi-label">Reorder Quantity</div><div id="reorderQty" class="kpi-value">80 pcs</div><div class="kpi-meta">Suggested replenishment</div></article></section>
<!-- "How We Forecast" info box hidden from users for now; kept in markup so it can be re-enabled later by removing the is-hidden class. -->
<section class="info-box is-hidden"><h3>How We Forecast: 7-Day Weighted Moving Average (WMA)</h3><div>Recent sales receive more weight, so the forecast responds to the latest demand pattern while smoothing one-off spikes.</div><div class="formula">WMA = (7 x D1 + 6 x D2 + 5 x D3 + 4 x D4 + 3 x D5 + 2 x D6 + 1 x D7) / 28</div></section>
<section class="dashboard-grid two-up"><article class="panel chart-box"><div class="panel-header"><h2>Historical Sales vs WMA</h2></div><div class="forecast-placeholder">Forecast chart coming soon</div><div id="forecastWarning" class="forecast-alert hidden"></div></article><article class="panel chart-box"><div class="panel-header"><h2>Predicted Stock Depletion</h2></div><div class="forecast-placeholder">Forecast chart coming soon</div></article></section>
<section class="dashboard-grid two-up"><article class="panel"><div class="panel-header"><h2>Forecast Accuracy</h2></div><div class="accuracy"><div><p class="panel-note">Average across products</p><strong id="accuracyText" class="accuracy-value">94.2%</strong></div><span class="status-badge status-healthy">Reliable</span></div></article><article class="panel"><div class="panel-header"><h2>Model Notes</h2></div><p class="panel-note">Forecasts use the local seven-day preview series. One product intentionally has insufficient history.</p></article></section>
<section class="panel"><div class="panel-header"><h2>Per-Product Forecast Summary</h2></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Avg Daily Sales</th><th>Depletion Date</th><th>Accuracy</th></tr></thead><tbody><tr><td>Whole Chicken</td><td>12 pcs</td><td>Oct 02</td><td>96%</td></tr><tr><td>Chicken Breast</td><td>15 kg</td><td>Sep 24</td><td>92%</td></tr><tr><td>Chicken Thigh</td><td>7 kg</td><td>Oct 08</td><td>95%</td></tr><tr><td>Chicken Wings</td><td>8.7 kg</td><td>Sep 27</td><td>91%</td></tr><tr><td>Chicken Feet</td><td class="insufficient">Insufficient Data</td><td class="insufficient">Insufficient Data</td><td class="insufficient">-</td></tr></tbody></table></div></section></div>
<script src="~/js/forecast.js" asp-append-version="true"></script>