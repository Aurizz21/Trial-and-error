@using PoultryOS.Models
@model ForecastPageViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Forecast";
}
<div class="module-page">
    <header class="module-heading">
        <div>
            <p class="greeting">Analytics workspace</p>
            <h1>Sales Forecast</h1>
            <p>7-day weighted moving average per product, computed from real sales history.</p>
        </div>
    </header>

    <section class="stat-strip">
        <article class="kpi-card">
            <div class="kpi-label">Products</div>
            <div class="kpi-value">@Model.TotalProducts</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Critical</div>
            <div class="kpi-value status-critical">@Model.CriticalCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Warning</div>
            <div class="kpi-value status-warning">@Model.WarningCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Avg Accuracy</div>
            <div class="kpi-value">@Model.AverageAccuracy.ToString("0.0")%</div>
        </article>
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2>Actual vs Forecast (Last 7 Days vs Next 7 Days)</h2>
            <p class="panel-note">Model: @Model.Model · Generated: @Model.GeneratedAt</p>
        </div>
        <div class="chart-plot" style="min-height:320px;">
            <canvas id="forecastChart"></canvas>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2>Forecast by Product</h2>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Current Stock</th>
                        <th>Last 7 Days</th>
                        <th>Daily WMA</th>
                        <th>Next 7 Forecast</th>
                        <th>Days Left</th>
                        <th>Predicted Depletion</th>
                        <th>Reorder</th>
                        <th>Accuracy</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.ProductName</td>
                            <td>@r.Category</td>
                            <td>@r.CurrentStock.ToString("0.##") @r.Units</td>
                            <td>@r.Last7DaysSales.ToString("0.##") @r.Units</td>
                            <td>@r.WeightedMovingAverage.ToString("0.##")</td>
                            <td>@r.ForecastNext7Days.ToString("0.##") @r.Units</td>
                            <td>@r.DaysRemaining.ToString("0.0")</td>
                            <td>@r.PredictedDepletionDate</td>
                            <td>@r.SuggestedReorderQuantity.ToString("0.##") @r.Units</td>
                            <td>
                                @if (r.ForecastAccuracy.HasValue)
                                {
                                    @r.ForecastAccuracy.Value.ToString("0.0")<text>%</text>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td><span class="status-badge status-@r.Status.ToLowerInvariant()">@r.Status</span></td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="11" class="empty-state">
                                <strong>No products to forecast</strong>
                                <span>Add products and record sales to see predictions.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
    window.forecastState = {
        chartData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData))
    };
</script>
<script>
    (function () {
        function drawChart() {
            const canvas = document.getElementById('forecastChart');
            if (!canvas) return;
            if (typeof Chart === 'undefined') {
                console.warn('Chart.js not loaded yet, retrying...');
                setTimeout(drawChart, 100);
                return;
            }

            const data = (window.forecastState && window.forecastState.chartData) || [];
            if (!data.length) {
                canvas.parentElement.innerHTML = '<p class="empty-state"><strong>No data to chart</strong></p>';
                return;
            }

            const labels = data.map(d => d.product || d.Product);
            const actual = data.map(d => d.last7DaysActual ?? d.Last7DaysActual ?? 0);
            const forecast = data.map(d => d.next7DaysForecast ?? d.Next7DaysForecast ?? 0);

            const root = getComputedStyle(document.documentElement);
            const primary = root.getPropertyValue('--chart-primary').trim() || '#2563eb';
            const warning = root.getPropertyValue('--chart-warning').trim() || '#f59e0b';
            const muted = root.getPropertyValue('--muted').trim() || '#6b7280';
            const grid = root.getPropertyValue('--chart-grid').trim() || 'rgba(0,0,0,0.06)';

            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Last 7 Days (actual)',
                            data: actual,
                            backgroundColor: primary,
                            borderRadius: 4,
                            maxBarThickness: 24
                        },
                        {
                            label: 'Next 7 Days (forecast)',
                            data: forecast,
                            backgroundColor: warning,
                            borderRadius: 4,
                            maxBarThickness: 24
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { grid: { display: false }, ticks: { color: muted } },
                        y: { beginAtZero: true, grid: { color: grid }, ticks: { color: muted } }
                    },
                    plugins: {
                        legend: {
                            labels: { color: muted, usePointStyle: true, pointStyle: 'circle' }
                        }
                    }
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', drawChart);
        } else {
            drawChart();
        }
    })();
</script>