@{ Layout = "~/Views/Shared/_DashboardLayout.cshtml"; ViewData["Title"] = "Audit Trail"; }
<div class="module-page" data-owner-only><span class="preview-badge">UI Preview - no backend yet</span><header class="module-heading"><div><p class="greeting">Owner workspace</p><h1>Audit Trail</h1><p>A clear history of activity across the preview workspace.</p></div></header>
<section class="panel"><div class="toolbar"><label class="field">From<input id="auditFrom" type="date"></label><label class="field">To<input id="auditTo" type="date"></label><label class="field">Action type<select id="auditAction"><option>All actions</option><option>Login</option><option>Sale</option><option>Stock Change</option><option>Alert Generated</option><option>Product Update</option></select></label><label class="field">User<select id="auditUser"><option>Everyone</option><option>Owner</option><option>Employee</option></select></label><button id="applyAudit" class="primary-btn" type="button">Apply</button></div><div class="table-wrap"><table><thead><tr><th>Timestamp</th><th>User</th><th>Action Type</th><th>Description</th></tr></thead><tbody id="auditBody"></tbody></table></div><div class="pagination"><span id="auditCount">Showing 12 preview events</span><span>Page 1 of 2 <button class="small-btn" type="button">Next</button></span></div></section></div>
<script src="~/js/audit.js" asp-append-version="true"></script>