@using System.Globalization
@using PoultryOS.Models
@model StockAlertsPageViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Stock Alerts";

    string Show(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    string ShowDays(double d) => d.ToString("0.#", CultureInfo.InvariantCulture);
}
<div class="module-page">
    <header class="module-heading">
        <div>
            <p class="greeting">Inventory workspace</p>
            <h1>Stock Alerts</h1>
            <p>Products that need restocking, ranked by urgency.</p>
        </div>
    </header>

    <section class="stat-strip">
        <article class="kpi-card">
            <div class="kpi-label">Active Alerts</div>
            <div class="kpi-value">@Model.TotalActive</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Critical</div>
            <div class="kpi-value status-critical">@Model.CriticalCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Warning</div>
            <div class="kpi-value status-warning">@Model.WarningCount</div>
        </article>
        <article class="kpi-card">
            <div class="kpi-label">Status</div>
            <div class="kpi-value accuracy-value">Live</div>
        </article>
    </section>

    <section class="panel">
        <div class="toolbar">
            <label class="field">Status
                <select id="alertStatusFilter" onchange="location.href='/Stock/Alerts?status=' + this.value">
                    @if (Model.StatusFilter == "All") { <option value="All" selected>All</option> } else { <option value="All">All</option> }
                    @if (Model.StatusFilter == "Critical") { <option value="Critical" selected>Critical</option> } else { <option value="Critical">Critical</option> }
                    @if (Model.StatusFilter == "Warning") { <option value="Warning" selected>Warning</option> } else { <option value="Warning">Warning</option> }
                </select>
            </label>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Product</th>
                        <th>Current Stock</th>
                        <th>Days Remaining</th>
                        <th>Suggested Reorder</th>
                        <th>Message</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Alerts)
                    {
                        <tr>
                            <td><span class="status-badge status-@a.Status.ToLowerInvariant()">@a.Status</span></td>
                            <td>@a.ProductName</td>
                            <td>@Show(a.CurrentStock) @a.Units</td>
                            <td>@ShowDays(a.DaysRemaining) days</td>
                            <td>@Show(a.SuggestedReorderQuantity) @a.Units</td>
                            <td>@a.Message</td>
                            <td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                    @if (!Model.Alerts.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <strong>No active alerts</strong>
                                <span>All products are above their reorder thresholds.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>