@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Sales History";
}
<div class="module-page">
    <header class="module-heading">
        <div>
            <p class="greeting">Sales workspace</p>
            <h1>Sales History</h1>
            <p>Review all recorded sales with filters and pagination.</p>
        </div>
        <button class="secondary-btn" type="button" disabled title="Coming soon">Export to CSV</button>
    </header>

    <section class="panel">
        <div class="toolbar">
            <label class="field">From
                <input id="historyFrom" type="date">
            </label>
            <label class="field">To
                <input id="historyTo" type="date">
            </label>
            <label class="field">Product
                <select id="historyProduct">
                    <option value="">All products</option>
                </select>
            </label>
            <label class="field">Entered by
                <select id="historyUser">
                    <option value="">Everyone</option>
                </select>
            </label>
            <div class="button-row">
                <button id="applyHistory" class="primary-btn" type="button">Apply</button>
                <button id="resetHistory" class="secondary-btn" type="button">Reset</button>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Entered By</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody id="historyBody">
                    <tr><td colspan="6" class="empty-state"><strong>Loading…</strong></td></tr>
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <span id="historyCount">—</span>
            <span>
                <button id="historyPrev" class="small-btn" type="button" disabled>Previous</button>
                <span id="historyPageInfo">Page 1</span>
                <button id="historyNext" class="small-btn" type="button" disabled>Next</button>
            </span>
        </div>
    </section>
</div>
<div id="historyToast" class="toast"></div>
<script src="~/js/sales-history.js" asp-append-version="true"></script>