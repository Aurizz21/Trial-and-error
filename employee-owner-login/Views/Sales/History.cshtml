@{ Layout = "~/Views/Shared/_DashboardLayout.cshtml"; ViewData["Title"] = "Sales History"; }
<div class="module-page"><span class="preview-badge">UI Preview - no backend yet</span><header class="module-heading"><div><p class="greeting">Sales workspace</p><h1>Sales History</h1><p>Review the last two weeks of recorded sales.</p></div><button class="secondary-btn" type="button">Export to CSV</button></header>
<section class="panel"><div class="toolbar"><label class="field">From<input id="historyFrom" type="date"></label><label class="field">To<input id="historyTo" type="date"></label><label class="field">Product<select id="historyProduct"><option>All products</option><option>Whole Chicken</option><option>Chicken Breast</option><option>Chicken Thigh</option><option>Chicken Wings</option><option>Chicken Feet</option></select></label><label class="field">Entered by<select id="historyUser"><option>Everyone</option><option>Owner</option><option>Maria</option></select></label><div class="button-row"><button id="applyHistory" class="primary-btn" type="button">Apply</button><button id="resetHistory" class="secondary-btn" type="button">Reset</button></div></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Time</th><th>Product</th><th>Quantity</th><th>Entered By</th><th>Notes</th></tr></thead><tbody id="historyBody"></tbody></table></div><div class="pagination"><span id="historyCount">Showing 12 preview entries</span><span>Page 1 of 3 <button class="small-btn" type="button">Next</button></span></div></section></div>
<script src="~/js/sales.js" asp-append-version="true"></script>