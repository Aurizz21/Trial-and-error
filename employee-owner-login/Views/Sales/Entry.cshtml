@model PoultryOS.Models.SalesEntryViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Sales Entry";
}

<div class="module-page">
    <header class="module-heading"><div><p class="greeting">Sales workspace</p><h1>Sales Entry</h1><p>Record today's outgoing stock.</p></div></header>
    <div class="module-grid">
        <div class="stack">
            <section class="panel">
                <div class="panel-header"><div><h2>New Sale Entry</h2><p class="panel-note">Record outgoing stock in the shared inventory.</p></div></div>
                <form id="saleEntryForm" class="form-grid" action="/Sales/RecordSale" method="post">
                    @Html.AntiForgeryToken()
                    <label class="field">Product<select id="saleProduct" name="ProductId" required><option value="">Select product</option>@foreach (var product in Model.Products){<option value="@product.Id" data-unit="@product.Units">@product.Name</option>}</select></label>
                    <label class="field">Quantity<div class="input-with-unit"><input id="saleQuantity" name="Quantity" type="number" min="1" step="1" placeholder="0" required /><span id="saleUnit" class="unit-label">pcs</span></div><small id="quantityError" role="alert" hidden></small></label>
                    <label class="field">Date<input id="saleDate" name="Date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></label>
                    <label class="field full">Notes (optional)<textarea id="saleNotes" name="Notes" placeholder="Add any observations, e.g. reason for high consumption..."></textarea></label>
                    <div class="button-row field full"><button id="recordSale" class="primary-btn" type="submit" disabled>Record Sale</button><button id="clearSale" class="secondary-btn" type="button">Clear</button></div>
                </form>
                <div id="saleToast" class="toast" aria-live="polite"></div>
            </section>
            <section class="panel"><div class="panel-header"><h2>Today's Entries</h2><span id="entriesCount" class="panel-note">@Model.TodaysSummary.EntriesCount entries</span></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Quantity</th><th>Entered By</th><th>Notes</th></tr></thead><tbody id="entriesBody">
                @if (Model.TodaysEntries.Count == 0)
                {
                    <tr><td colspan="4" class="empty-state">No sales recorded today.</td></tr>
                }
                @foreach (var entry in Model.TodaysEntries)
                {
                    <tr><td>@entry.ProductName<small>@entry.Date.ToString("h:mm tt")</small></td><td>@entry.Quantity.ToString("0.##") @entry.Unit</td><td>@entry.EnteredBy</td><td>@(string.IsNullOrEmpty(entry.Notes) ? "-" : entry.Notes)</td></tr>
                }
            </tbody></table></div></section>
        </div>
        <aside class="stack"><section class="panel"><div class="panel-header"><h2>Today's Summary</h2></div><dl class="summary-list"><div><dt>Total Units Sold</dt><dd id="todaysTotalUnits">@Model.TodaysSummary.TotalUnitsSold</dd></div><div><dt>Entries</dt><dd id="entryCount">@Model.TodaysSummary.EntriesCount</dd></div><div><dt>Products Affected</dt><dd id="productsAffected">@Model.TodaysSummary.ProductsAffectedCount of @Model.TodaysSummary.TotalProducts</dd></div></dl></section><section class="panel"><div class="panel-header"><h2>Low Stock Products</h2></div><div id="lowStockList" class="mini-list">
            @if (Model.LowStockProducts.Count == 0)
            {
                <p class="empty-state">No products currently need attention.</p>
            }
            @foreach (var item in Model.LowStockProducts)
            {
                <div class="mini-row"><div><strong>@item.ProductName</strong><small>Remaining stock: @item.CurrentStock.ToString("0.##") @item.Units</small></div><span class="status-badge status-@item.Status.ToLowerInvariant()">@item.Status</span></div>
            }
        </div></section></aside>
    </div>
</div>
<script src="~/js/sales.js" asp-append-version="true"></script>